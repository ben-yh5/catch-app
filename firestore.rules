rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      // Authenticated users can read user profiles (for viewing other users)
      allow read: if request.auth != null;

      // Users can create their own document
      allow create: if request.auth != null && request.auth.uid == userId;

      // Users can delete their own document
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Users can update their own document (restricted to safe fields only)
      // Server-computed fields (totalPosts, totalCatches, followers, following) are only writable by Cloud Functions
      allow update: if request.auth != null && request.auth.uid == userId &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['username', 'pushToken', 'notificationSettings', 'dataContributionEnabled', 'passportPublic', 'bio']);

      // Follow/unfollow operations are handled atomically by followUser/unfollowUser Cloud Functions
      // No client-side updates to followers or following arrays

      // Notifications subcollection
      match /notifications/{notifId} {
        allow get: if request.auth != null && request.auth.uid == userId;
        allow list: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        // Only Cloud Functions (admin SDK) creates notifications, client can mark as read
        allow update: if request.auth != null && request.auth.uid == userId &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
    }

    // Posts collection
    match /posts/{postId} {
      // Anyone can read posts
      allow read: if true;

      // Only authenticated users can create posts, must set authorId to own uid.
      // Password-provider accounts must have a verified email (Google/Apple
      // arrive pre-verified). Originals must not claim thread membership;
      // catches require a live permit issued by the validateCatch Cloud
      // Function (proximity passed), so a scripted client can't mint catches
      // without being there.
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.authorId &&
                       (request.auth.token.firebase.sign_in_provider != 'password' ||
                        request.auth.token.email_verified == true) &&
                       (
                         (request.resource.data.isOriginal == true &&
                          request.resource.data.get('parentPostId', null) == null &&
                          request.resource.data.get('rootPostId', null) == null) ||
                         (request.resource.data.isOriginal == false &&
                          request.resource.data.parentPostId is string &&
                          request.resource.data.rootPostId is string &&
                          exists(/databases/$(database)/documents/catch_permits/$(request.auth.uid + '_' + request.resource.data.rootPostId)) &&
                          get(/databases/$(database)/documents/catch_permits/$(request.auth.uid + '_' + request.resource.data.rootPostId)).data.expiresAt > request.time)
                       );

      // Only the post author can delete their posts
      allow delete: if request.auth != null &&
                       request.auth.uid == resource.data.authorId;

      // No client-side updates — catchCount managed by Cloud Functions (onPostCreated/onPostDeleted)
      allow update: if false;
    }

    // Post locations collection
    match /post_locations/{locationId} {
      // No read access (location data is private)
      allow read: if false;

      // Authenticated users can create location documents with required fields and valid coordinates
      allow create: if request.auth != null &&
                       request.resource.data.keys().hasAll(['postId', 'latitude', 'longitude', 'geohash']) &&
                       request.resource.data.latitude is number &&
                       request.resource.data.longitude is number &&
                       request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90 &&
                       request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180;

      // No updates or deletes from clients (only Cloud Functions can manage)
      allow update, delete: if false;
    }

    // Lists collection
    match /lists/{listId} {
      // Anyone can read lists (all lists are public)
      allow read: if true;

      // Only authenticated users can create lists
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.creatorId;

      // Only creator can update/delete
      allow update, delete: if request.auth != null &&
                            request.auth.uid == resource.data.creatorId;
    }

    // Training pairs collection
    match /training_pairs/{pairId} {
      // Allow authenticated users to contribute data
      allow create: if request.auth != null;
      // No client-side read/update/delete
      allow read, update, delete: if false;
    }

    // Usernames collection (uniqueness index, managed by setupUsername Cloud Function)
    match /usernames/{username} {
      // Allow reads for username availability checks
      allow read: if true;
      // Only Cloud Functions (admin SDK) can write
      allow create, update, delete: if false;
    }

    // Processed events collection (deduplication for Firestore triggers)
    match /processed_events/{eventId} {
      // No client access — only written by Cloud Functions (admin SDK)
      allow read, write: if false;
    }

    // Catch permits (issued by validateCatch, consumed by onPostCreated).
    // Referenced via get()/exists() in the posts create rule above.
    match /catch_permits/{permitId} {
      // No client access — only Cloud Functions (admin SDK)
      allow read, write: if false;
    }

    // User recommendations collection (managed by Cloud Functions only)
    match /user_recommendations/{userId} {
      // Only the user themselves can read their recommendations
      allow read: if request.auth != null && request.auth.uid == userId;
      // Only Cloud Functions (admin SDK) can write
      allow create, update, delete: if false;
    }

    // Reports collection (managed by Cloud Functions only)
    match /reports/{reportId} {
      // No client access — only written/read by Cloud Functions (admin SDK)
      allow read, write: if false;
    }

    // Coverage cells (global post density aggregates, managed by Cloud Functions)
    match /geohash_cells/{cellId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // User coverage (personal visited areas, managed by Cloud Functions)
    match /user_coverage/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
