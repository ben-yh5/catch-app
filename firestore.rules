rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      // Anyone can read user profiles (for viewing other users)
      allow read: if true;

      // Users can create their own document
      allow create: if request.auth != null && request.auth.uid == userId;

      // Users can delete their own document
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Users can update their own document
      allow update: if request.auth != null && request.auth.uid == userId;

      // Allow authenticated users to update the followers list (to follow/unfollow)
      allow update: if request.auth != null &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers']);

      // Allow update: if request.auth != null &&
      //                  request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers', 'following']);
      
      // Notifications subcollection
        allow get: if request.auth != null && request.auth.uid == userId;
        allow list: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        // Only Cloud Functions (admin SDK) creates notifications, but in case client needs to mark read (update)
        allow update: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Posts collection
    match /posts/{postId} {
      // Anyone can read posts
      allow read: if true;

      // Only authenticated users can create posts
      allow create: if request.auth != null;

      // Only the post author can delete their posts
      allow delete: if request.auth.uid == resource.data.authorId;

      // Allow updates only to catchCount field (for catches)
      allow update: if request.auth != null &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['catchCount']);
    }

    // Post locations collection
    match /post_locations/{locationId} {
      // No read access (location data is private)
      allow read: if false;

      // Allow authenticated users to create location documents
      allow create: if request.auth != null;

      // No updates or deletes from clients (only Cloud Functions can delete)
      allow update, delete: if false;
    }

    // Lists collection
    match /lists/{listId} {
      // Anyone can read lists (all lists are public)
      allow read: if true;

      // Only authenticated users can create lists
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.creatorId;

      // Only creator can update/delete
      allow update, delete: if request.auth != null &&
                            request.auth.uid == resource.data.creatorId;
    }

    // Training pairs collection
    match /training_pairs/{pairId} {
      // Allow authenticated users to contribute data
      allow create: if request.auth != null;
      // No client-side read/update/delete
      allow read, update, delete: if false;
    }
  }
}
