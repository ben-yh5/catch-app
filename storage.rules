rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user is the owner of the path
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper to validate image uploads (content type + size)
    function isValidImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)')
             && request.resource.size <= 10 * 1024 * 1024; // 10MB max
    }

    // Posts: Allow uploading to own folder, reading all
    match /posts/{userId}/{imageId} {
      allow read: if true;
      allow write: if isAuthenticated() && isOwner(userId) && isValidImage();
    }

    // Training Data: opted-in clients upload pairs (opt-in checked client-side
    // to avoid a Firestore lookup here). No client reads: contributed photos
    // include never-published catch attempts, and the only reader is the
    // offline training pipeline, which uses the Admin SDK and bypasses rules.
    match /training_data/{pairId}/{imageId} {
      allow read: if false;
      allow write: if isAuthenticated() && isValidImage();
    }

    // Profile pictures (if applicable)
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isOwner(userId) && isValidImage();
    }
  }
}
