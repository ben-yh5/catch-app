GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated Firebase Auth UIDs allowed to call admin-only functions
# (backfillEmbeddings, backfillCoverage). Find your UID in Firebase Console >
# Authentication, or via user.uid in the app while logged in. Fails closed
# if empty — nobody passes requireAdmin() until this is set.
ADMIN_UIDS=
